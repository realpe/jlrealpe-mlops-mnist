# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Plantilla de variables de entorno. Se COPIA a .env localmente (que SI esta
# en .gitignore). Aqui van solo los NOMBRES, nunca los valores reales.
#
# En el pipeline, estos valores vienen de GitHub Secrets, no de este archivo.
# =============================================================================

# --- Referencia al modelo (cumple "solo una referencia, no el archivo") ---
MODEL_BLOB_CONTAINER=models
MODEL_BLOB_NAME=mnist-12.onnx

# --- Datos de prueba ---
DATA_BLOB_CONTAINER=data

# --- Predicciones (se elige segun el entorno) ---
ENVIRONMENT=dev
PREDICTIONS_CONTAINER=predictions

# --- Conexion a Azure Blob Storage (el VALOR real va en GitHub Secrets) ---
AZURE_STORAGE_CONNECTION_STRING=

# --- Umbral de la metrica para el quality gate en tests ---
ACCURACY_THRESHOLD=0.90
